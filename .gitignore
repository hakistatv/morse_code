# ESP-IDF build output
build/

# Managed component cache (re-fetched from idf_component.yml + dependencies.lock)
managed_components/

# Per-machine generated config (compiled target/port/etc.) -- sdkconfig.defaults
# is what's checked in; this file is regenerated by `idf.py set-target`/`build`.
sdkconfig
sdkconfig.old

# Editor/OS cruft
.DS_Store

# Local scratch: Morse WAV generator + its generated audio, used only for
# bench testing the tone against a reference. Not part of the firmware.
test_audio/

# Per-machine VS Code settings (idf.port, idf.customExtraVars, clangd.path,
# etc. -- all absolute paths/ports specific to whoever's machine set them
# up). .clangd at the repo root is the shareable, machine-independent
# clangd config; this is the personal one.
.vscode/
